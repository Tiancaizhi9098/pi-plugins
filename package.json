{
  "name": "pi-plugins",
  "version": "1.4.0",
  "description": "Pi and OMP plugins: model system prompts, goal recovery, and per-conversation temporary workspaces.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tiancaizhi9098/pi-plugins.git"
  },
  "homepage": "https://github.com/Tiancaizhi9098/pi-plugins#readme",
  "bugs": {
    "url": "https://github.com/Tiancaizhi9098/pi-plugins/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "plugins"
  ],
  "files": [
    "plugins",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./plugins/model-system-prompts/src/index.ts",
      "./plugins/goal-retry/dist/index.ts",
      "./plugins/temp-workspaces/index.js"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@oh-my-pi/pi-coding-agent": ">=18.15.0"
  },
  "devDependencies": {
    "@narumitw/pi-tui-kit": "0.69.1",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@oh-my-pi/pi-coding-agent": "18.15.0",
    "@types/bun": "1.4.4",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "esbuild": "0.28.2"
  },
  "scripts": {
    "test": "npm run test:pi && npm run test:omp && npm run test:goal && npm run test:temp-workspaces",
    "test:temp-workspaces": "node --test plugins/temp-workspaces/test/*.test.mjs",
    "typecheck": "tsc --noEmit -p plugins/model-system-prompts/tsconfig.json && tsc --noEmit -p plugins/goal-retry/tsconfig.json",
    "build:goal": "node plugins/goal-retry/scripts/build.mjs",
    "test:goal": "node --test plugins/goal-retry/test/*.test.mjs",
    "test:pi": "node --test plugins/model-system-prompts/tests/*.test.ts",
    "test:omp": "bun test --preload ./plugins/model-system-prompts/tests/omp/preload.ts ./plugins/model-system-prompts/tests/omp"
  },
  "omp": {
    "extensions": [
      "./plugins/model-system-prompts/src/omp.ts"
    ]
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  }
}
